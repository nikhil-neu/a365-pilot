// Fill from a reviewed known-good snapshot; empty approved baseline reports every record for review.
let Approved = datatable(AgentId:string, ApprovedPermissionsHash:string, ApprovedToolsHash:string) [];
AgentsInfo
| where Timestamp > ago(7d)
| summarize arg_max(Timestamp, *) by AgentId
| extend PermissionsHash=hash_sha256(tostring(Permissions)), ToolsHash=hash_sha256(tostring(DeclaredTools))
| join kind=leftouter Approved on AgentId
| where isempty(ApprovedPermissionsHash) or PermissionsHash != ApprovedPermissionsHash or ToolsHash != ApprovedToolsHash
| project Timestamp, AgentId, AgentName, PermissionsHash, ToolsHash, ApprovedPermissionsHash, ApprovedToolsHash
